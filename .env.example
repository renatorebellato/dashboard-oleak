# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto Supabase (Painel do Supabase > Settings > API, ou botão "Connect").
# Use um projeto Supabase NOVO e separado, dedicado à Oleak.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Sincronização automática (rota /api/cron/sync) ---
# Estas variáveis são SEGREDOS reais — nunca prefixe com NEXT_PUBLIC_ e
# nunca cole em nenhum lugar público. Configure-as direto no painel da
# Vercel (Settings > Environment Variables), não neste arquivo.

# Chave secreta que você mesmo inventa (ex: gere com `openssl rand -hex 32`).
# Protege a rota /api/cron/sync de ser chamada por qualquer pessoa. A Vercel
# Cron já envia essa chave sozinha, você só usa manualmente para testar.
CRON_SECRET=

# Service role key do MESMO projeto Supabase acima (Settings > API > service_role).
# Dá acesso total ao banco, ignorando as regras de RLS — só usada no servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Meta Marketing API — token de System User (Business Settings > Usuários do
# sistema), com permissão ads_read na conta da Oleak. App Secret vem do app
# em developers.facebook.com (Configurações básicas do app).
META_ACCESS_TOKEN=
META_APP_SECRET=

# Google Ads API — developer token da sua conta de gerenciador (MCC), mais
# credenciais OAuth2 (Google Cloud Console) e um refresh token gerado uma
# vez para um usuário com acesso à conta da Oleak dentro do MCC.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# ID do MCC "Elo Criativo" (só dígitos, sem hífen).
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Login por cliente (multi-tenant) ---
# Chave secreta usada só para ASSINAR o cookie de sessão (gere com
# `openssl rand -hex 32`). A senha de cada cliente NÃO fica em env var — fica
# com hash na tabela "clients" do Supabase.
DASH_AUTH_SECRET=
